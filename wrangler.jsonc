{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fiaxe-website",
  "main": "worker/index.ts",

  // Veeransh@fiaxe.com. Pinned so a `wrangler login` under a different account
  // cannot silently deploy this site somewhere else.
  "account_id": "e5d0ecc8ece937004ed24fd6a708e015",
  "compatibility_date": "2026-08-11",

  // No custom domain for now: the site is served only from
  // fiaxe-website.veeransh.workers.dev.
  "workers_dev": true,

  "assets": {
    // `npm run build` writes the static export here (output: "export").
    "directory": "./out",
    "binding": "ASSETS",

    // Default. Serves out/agents.html at /agents, so the extensionless URLs
    // work without the Netlify-style rewrite rules we used to ship.
    "html_handling": "auto-trailing-slash",

    // Next.js emits out/404.html.
    "not_found_handling": "404-page",

    // The Worker has to see real navigations to 308 www -> the apex, and
    // Cloudflare matches these globs on path only, so it cannot be scoped to
    // the www hostname. Everything runs the Worker first except /_next/*, the
    // hashed JS/CSS bundle that is the bulk of the request volume. The cost is
    // that a hotlinked /_next/* URL on www skips the redirect and serves the
    // asset, which is harmless -- no HTML, nothing for a crawler to index.
    // The static media folders skip the Worker for the same reason.
    "run_worker_first": ["/*", "!/_next/*", "!/recordings/*", "!/logos/*", "!/hero/*"]
  },

  // Not bound to the fiaxe.com zone, so this Worker can post to n8n directly
  // and the forwarder (worker/n8n-forwarder.ts) is not needed. Put the
  // forwarder's workers.dev URL back here if a fiaxe.com custom domain returns.
  "vars": { "N8N_FORWARD_URL": "https://n8n.fiaxe.com/webhook/6307d669-2cfb-403f-92b3-26754074f984" },

  "observability": { "enabled": true }
}
