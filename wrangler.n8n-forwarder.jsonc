{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fiaxe-website-n8n-forwarder",
  "main": "worker/n8n-forwarder.ts",

  "account_id": "bc179c6141c15f2b2f69a8615300724b",
  "compatibility_date": "2026-08-11",

  // Deliberately no `routes` and no custom domain: being unattached to the
  // fiaxe.com zone is the whole point (see worker/n8n-forwarder.ts). The
  // workers.dev URL is required -- the site Worker reaches this one over real
  // HTTP, because a service binding would inherit its zone context and loop.
  "workers_dev": true,

  "observability": { "enabled": true }
}
