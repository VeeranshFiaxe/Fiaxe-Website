# Workers Static Assets headers. Media is cached for a year: replace a file
# under a new name (or add ?v=) instead of editing it in place.
/recordings/*
  Cache-Control: public, max-age=31536000, immutable
/logos/*
  Cache-Control: public, max-age=31536000, immutable
/hero/*
  Cache-Control: public, max-age=31536000, immutable
